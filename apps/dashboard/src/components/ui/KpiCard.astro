---
export interface Props {
  title: string;
  value: string | number;
  unit?: string;
  trend?: 'up' | 'down' | 'neutral';
  trendValue?: string;
  status?: 'success' | 'warning' | 'danger';
  iconName?: string;
}

const { title, value, unit = '', trend, trendValue, status = 'success', iconName } = Astro.props;

const statusColorMap = {
  success: 'var(--color-status-success)',
  warning: 'var(--color-status-warning)',
  danger: 'var(--color-status-danger)'
};

const statusBgMap = {
  success: 'var(--color-status-success-container)',
  warning: 'var(--color-status-warning-container)',
  danger: 'var(--color-status-danger-container)'
};
---

<div class="m3-card kpi-card">
  <div class="kpi-header">
    <span class="kpi-title">{title}</span>
    {iconName && (
      <div class="kpi-icon-wrapper" style={`background-color: ${statusBgMap[status]}; color: ${statusColorMap[status]};`} aria-hidden="true">
        {iconName === 'activity' && (
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
          </svg>
        )}
        {iconName === 'zap' && (
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
          </svg>
        )}
        {iconName === 'accessibility' && (
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="4" r="2"></circle>
            <path d="m18 19 1-7-6 1"></path>
            <path d="m5 8 3-3 5.5 3-2.36 3.5"></path>
            <path d="M4.24 14.5a5 5 0 0 0 6.88 6"></path>
            <path d="M13.76 17.5a5 5 0 0 0-1.76-3"></path>
          </svg>
        )}
        {iconName === 'alert-triangle' && (
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path>
            <line x1="12" y1="9" x2="12" y2="13"></line>
            <line x1="12" y1="17" x2="12.01" y2="17"></line>
          </svg>
        )}
      </div>
    )}
  </div>

  <div class="kpi-body">
    <div class="kpi-value-container">
      <span class="kpi-value">{value}</span>
      {unit && <span class="kpi-unit">{unit}</span>}
    </div>

    {trendValue && (
      <div class={`kpi-trend trend-${trend || 'neutral'}`}>
        {trend === 'up' && (
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="18 15 12 9 6 15"></polyline>
          </svg>
        )}
        {trend === 'down' && (
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        )}
        <span>{trendValue}</span>
      </div>
    )}
  </div>
</div>

<style>
  .kpi-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .kpi-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .kpi-title {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--md-sys-color-on-surface-variant);
    letter-spacing: 0.02em;
  }

  .kpi-icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--md-shape-sm);
  }

  .kpi-body {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .kpi-value-container {
    display: flex;
    align-items: baseline;
    gap: var(--space-1);
  }

  .kpi-value {
    font-size: var(--text-3xl);
    font-weight: 800;
    color: var(--md-sys-color-on-surface);
    line-height: 1;
  }

  .kpi-unit {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--md-sys-color-on-surface-variant);
  }

  .kpi-trend {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: var(--text-xs);
    font-weight: 700;
    padding: 2px 8px;
    border-radius: var(--md-shape-full);
  }

  .trend-up {
    color: var(--color-status-success);
    background-color: var(--color-status-success-container);
  }

  .trend-down {
    color: var(--color-status-danger);
    background-color: var(--color-status-danger-container);
  }

  .trend-neutral {
    color: var(--md-sys-color-on-surface-variant);
    background-color: var(--md-sys-color-surface-container);
  }
</style>
