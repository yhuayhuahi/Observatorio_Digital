---
export interface Props {
  score: number;
  label?: string;
  showDetails?: boolean;
}

const { score, label = 'Cumplimiento WCAG 2.1 AA', showDetails = true } = Astro.props;

let colorClass = 'var(--color-status-success)';
let bgClass = 'var(--color-status-success-container)';
if (score < 75) {
  colorClass = 'var(--color-status-danger)';
  bgClass = 'var(--color-status-danger-container)';
} else if (score < 90) {
  colorClass = 'var(--color-status-warning)';
  bgClass = 'var(--color-status-warning-container)';
}
---

<div class="wcag-bar-wrapper">
  {showDetails && (
    <div class="wcag-header">
      <span class="wcag-label">{label}</span>
      <span class="wcag-score" style={`color: ${colorClass};`}>{score}%</span>
    </div>
  )}
  <div
    class="wcag-track"
    role="progressbar"
    aria-valuenow={score}
    aria-valuemin="0"
    aria-valuemax="100"
    aria-label={label}
    style={`background-color: ${bgClass};`}
  >
    <div
      class="wcag-fill"
      style={`width: ${Math.min(100, Math.max(0, score))}%; background-color: ${colorClass};`}
    ></div>
  </div>
</div>

<style>
  .wcag-bar-wrapper {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    width: 100%;
  }

  .wcag-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: var(--text-xs);
    font-weight: 600;
  }

  .wcag-label {
    color: var(--md-sys-color-on-surface-variant);
  }

  .wcag-score {
    font-weight: 700;
  }

  .wcag-track {
    width: 100%;
    height: 8px;
    border-radius: var(--md-shape-full);
    overflow: hidden;
  }

  .wcag-fill {
    height: 100%;
    border-radius: var(--md-shape-full);
    transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }
</style>
