---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import KpiCard from '../components/ui/KpiCard.astro';
import BadgeStatus from '../components/ui/BadgeStatus.astro';
import WcagComplianceBar from '../components/ui/WcagComplianceBar.astro';
import { getGlobalStats, getRankings } from '../services/api';

const stats = await getGlobalStats();
const rankings = await getRankings();

const top5Best = rankings.slice(0, 5);
const top5Worst = [...rankings].reverse().slice(0, 5);
---

<DashboardLayout title="Resumen Ejecutivo" currentPath="/">
  <div class="container executive-view">
    {/* Hero Section */}
    <section class="hero-section" aria-labelledby="hero-title">
      <div class="hero-content">
        <div class="hero-badge">
          <span>MONITOREO DE SERVICIOS DIGITALES</span>
        </div>
        <h1 id="hero-title" class="hero-title">
          Observatorio de Calidad Digital del Estado Peruano
        </h1>
        <p class="hero-desc">
          Evaluación continua de disponibilidad, velocidad y accesibilidad universal en <strong>{stats.totalEntities} portales institucionales</strong>, en cumplimiento del D.L. N° 1412, D.S. N° 029-2021-PCM y la R.SGTD N° 001-2025-PCM/SGTD.
        </p>

        <div class="hero-actions">
          <a href="/ranking" class="m3-btn m3-btn-primary">
            Explorar Ranking Nacional Completo
          </a>
          <a href="/auditor-ia" class="m3-btn m3-btn-tonal">
            <span>✨ Consultar con Auditor IA</span>
          </a>
        </div>
      </div>
    </section>

    {/* Global KPIs Grid */}
    <section class="kpis-section" aria-label="Indicadores Clave Globales">
      <div class="grid-cols-4">
        <KpiCard
          title="Disponibilidad Promedio"
          value={stats.avgAvailability}
          unit="%"
          trend="up"
          trendValue="+0.4% vs mes ant."
          status={stats.avgAvailability >= 99.0 ? 'success' : 'warning'}
          iconName="activity"
        />
        <KpiCard
          title="Velocidad LCP Mediana"
          value={stats.avgLcp}
          unit="seg"
          trend="down"
          trendValue="-0.3s (Mejora)"
          status={stats.avgLcp <= 2.5 ? 'success' : 'warning'}
          iconName="zap"
        />
        <KpiCard
          title="Accesibilidad WCAG 2.1"
          value={stats.avgAccessibility}
          unit="/100"
          trend="up"
          trendValue="+1.8 pts"
          status={stats.avgAccessibility >= 80 ? 'success' : 'warning'}
          iconName="accessibility"
        />
        <KpiCard
          title="Incidentes Activos"
          value={stats.activeIncidents}
          unit="portales"
          trend={stats.activeIncidents > 0 ? 'down' : 'neutral'}
          trendValue={stats.activeIncidents > 0 ? 'Requiere Atención' : '100% Operativo'}
          status={stats.activeIncidents === 0 ? 'success' : 'danger'}
          iconName="alert-triangle"
        />
      </div>
    </section>

    {/* Top 5 Best & Top 5 Worst Entities Section */}
    <section class="comparison-section" aria-label="Comparativa de Portales Destacados">
      <div class="grid-cols-2">
        {/* Top 5 Best */}
        <div class="m3-card">
          <div class="card-header">
            <div>
              <h2 class="card-title">Top 5: Mayor Calidad Digital</h2>
              <p class="card-subtitle">Portales con mayor puntuación ponderada y cumplimiento de SLA</p>
            </div>
            <span class="m3-chip m3-chip-success">Líderes</span>
          </div>

          <div class="m3-table-wrapper" style="border: none; box-shadow: none;">
            <table class="m3-table">
              <thead>
                <tr>
                  <th scope="col" style="width: 40px; text-align: center;">#</th>
                  <th scope="col">Entidad</th>
                  <th scope="col" style="text-align: right;">Score</th>
                  <th scope="col" style="text-align: center;">SLA</th>
                </tr>
              </thead>
              <tbody>
                {top5Best.map((entity) => (
                  <tr>
                    <td style="text-align: center; font-weight: 800;">
                      <span class="rank-pill rank-pill-top">{entity.posicion}</span>
                    </td>
                    <td>
                      <a href={`/entidad/${entity.id}`} class="entity-table-link">
                        {entity.nombre}
                      </a>
                      <span class="entity-table-cat">{entity.categoria} &bull; {entity.region || 'Nacional'}</span>
                    </td>
                    <td style="text-align: right; font-weight: 800; color: var(--color-status-success);">
                      {entity.scoreGlobal.toFixed(1)}
                    </td>
                    <td style="text-align: center;">
                      <BadgeStatus status={entity.estadoSla} />
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <div class="card-footer-action">
            <a href="/ranking" class="m3-btn m3-btn-outlined" style="width: 100%;">
              Ver los 90 portales evaluados &rarr;
            </a>
          </div>
        </div>

        {/* Top 5 Critical */}
        <div class="m3-card">
          <div class="card-header">
            <div>
              <h2 class="card-title">Top 5: Atención Prioritaria</h2>
              <p class="card-subtitle">Portales con degradación de velocidad o incumplimiento normativo</p>
            </div>
            <span class="m3-chip m3-chip-danger">En Riesgo</span>
          </div>

          <div class="m3-table-wrapper" style="border: none; box-shadow: none;">
            <table class="m3-table">
              <thead>
                <tr>
                  <th scope="col" style="width: 40px; text-align: center;">#</th>
                  <th scope="col">Entidad</th>
                  <th scope="col" style="text-align: right;">Score</th>
                  <th scope="col" style="text-align: center;">SLA</th>
                </tr>
              </thead>
              <tbody>
                {top5Worst.map((entity) => (
                  <tr>
                    <td style="text-align: center; font-weight: 800;">
                      <span class="rank-pill rank-pill-bottom">{entity.posicion}</span>
                    </td>
                    <td>
                      <a href={`/entidad/${entity.id}`} class="entity-table-link">
                        {entity.nombre}
                      </a>
                      <span class="entity-table-cat">{entity.categoria} &bull; {entity.region || 'Nacional'}</span>
                    </td>
                    <td style="text-align: right; font-weight: 800; color: var(--color-status-danger);">
                      {entity.scoreGlobal.toFixed(1)}
                    </td>
                    <td style="text-align: center;">
                      <BadgeStatus status={entity.estadoSla} />
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <div class="card-footer-action">
            <a href="/incidentes" class="m3-btn m3-btn-outlined" style="width: 100%;">
              Ver tablero de incidentes activos &rarr;
            </a>
          </div>
        </div>
      </div>
    </section>

    {/* Legal & Regulatory Alignment Banner */}
    <section class="normative-banner m3-card" aria-label="Alineamiento Legal Oficial">
      <div class="normative-grid">
        <div class="normative-item">
          <span class="normative-code">D.L. 1412</span>
          <h4>Ley de Gobierno Digital</h4>
          <p>Exige que los servicios digitales del Estado garanticen continuidad operativa y arquitectura interoperable.</p>
        </div>
        <div class="normative-item">
          <span class="normative-code">D.S. 029-2021-PCM</span>
          <h4>Reglamento de Gobierno Digital</h4>
          <p>Establece la obligatoriedad del cumplimiento de accesibilidad universal WCAG 2.1 AA en plataformas públicas.</p>
        </div>
        <div class="normative-item">
          <span class="normative-code">R.SGTD 001-2025</span>
          <h4>Directiva de Calidad Técnica</h4>
          <p>Fija el SLA mínimo del 99.5% de disponibilidad mensual y umbrales de Core Web Vitals (LCP &le; 2.5s).</p>
        </div>
      </div>
    </section>
  </div>
</DashboardLayout>

<style>
  .executive-view {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  /* Hero */
  .hero-section {
    background: linear-gradient(135deg, var(--md-sys-color-surface-container) 0%, var(--md-sys-color-surface-container-high) 100%);
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: var(--md-shape-lg);
    padding: var(--space-8);
    box-shadow: var(--md-sys-elevation-1);
  }

  .hero-badge {
    display: inline-block;
    background-color: var(--md-sys-color-primary-container);
    color: var(--md-sys-color-on-primary-container);
    font-size: var(--text-xs);
    font-weight: 700;
    padding: 4px 12px;
    border-radius: var(--md-shape-full);
    margin-bottom: var(--space-3);
    letter-spacing: 0.05em;
  }

  .hero-title {
    font-size: var(--text-4xl);
    font-weight: 800;
    margin-bottom: var(--space-3);
    color: var(--md-sys-color-on-surface);
  }

  .hero-desc {
    font-size: var(--text-lg);
    max-width: 850px;
    margin-bottom: var(--space-6);
    color: var(--md-sys-color-on-surface-variant);
    line-height: 1.6;
  }

  .hero-actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  /* Cards */
  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: var(--space-4);
  }

  .card-title {
    font-size: var(--text-lg);
    font-weight: 700;
    margin: 0;
  }

  .card-subtitle {
    font-size: var(--text-xs);
    color: var(--md-sys-color-on-surface-variant);
    margin: 2px 0 0;
  }

  .rank-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border-radius: var(--md-shape-full);
    font-size: var(--text-xs);
  }

  .rank-pill-top {
    background-color: var(--color-status-success-container);
    color: var(--color-status-success);
  }

  .rank-pill-bottom {
    background-color: var(--color-status-danger-container);
    color: var(--color-status-danger);
  }

  .entity-table-link {
    font-weight: 700;
    color: var(--md-sys-color-on-surface);
    text-decoration: none;
    display: block;
  }

  .entity-table-link:hover {
    color: var(--md-sys-color-primary);
  }

  .entity-table-cat {
    font-size: 11px;
    color: var(--md-sys-color-on-surface-variant);
    display: block;
  }

  .card-footer-action {
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid var(--md-sys-color-outline-variant);
  }

  /* Normative Banner */
  .normative-banner {
    background-color: var(--md-sys-color-surface-container-low);
  }

  .normative-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  .normative-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .normative-code {
    display: inline-block;
    align-self: flex-start;
    background-color: var(--md-sys-color-secondary-container);
    color: var(--md-sys-color-on-secondary-container);
    font-size: 11px;
    font-weight: 800;
    padding: 2px 8px;
    border-radius: var(--md-shape-xs);
  }

  .normative-item h4 {
    font-size: var(--text-base);
    margin: 0;
  }

  .normative-item p {
    font-size: var(--text-xs);
    line-height: 1.5;
    margin: 0;
  }

  @media (max-width: 800px) {
    .hero-title {
      font-size: var(--text-2xl);
    }
    .normative-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
