# ==============================================================================
# CONFIGURACIÓN DEL BACKEND API Y SUBSISTEMA RAG (apps/api) - PLANTILLA
# ==============================================================================

PORT=3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 1. Google Gemini API (Para el Chatbot RAG y Generación de Embeddings)
# Obtén tu clave gratuita en: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=tu_gemini_api_key_aqui
GEMINI_MODEL=gemini-3.5-flash

# ------------------------------------------------------------------------------
# 2. Configuración de Scheduler y Seguridad
# ------------------------------------------------------------------------------
ENABLE_INTERNAL_SCHEDULER=false
ADMIN_API_KEY=dev-secret-key-2026

# ------------------------------------------------------------------------------
# 3. Supabase y Base de Datos (PostgreSQL)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu_anon_key
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key
DATABASE_URL=postgresql://postgres.tu-ref:password@aws-0-ca-central-1.pooler.supabase.com:5432/postgres
GOOGLE_PAGESPEED_API_KEY=tu_pagespeed_api_key
